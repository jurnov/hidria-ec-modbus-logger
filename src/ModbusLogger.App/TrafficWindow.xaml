<Window x:Class="ModbusLogger.App.TrafficWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modbus promet (HEX)" Height="500" Width="780" MinHeight="300" MinWidth="520"
        Icon="Assets/hidria.ico">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#777" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Zadnjih do 500 izmenjav na trenutno odprtem portu. Ena vrstica = en poslan Modbus RTU zahtevek in nanj prejet odgovor (surovi bajti, HEX). Oranžno = ni bilo odgovora (timeout)."/>

        <DataGrid Grid.Row="1" x:Name="ExchangeGrid" ItemsSource="{Binding TrafficLog}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserSortColumns="False" CanUserReorderColumns="False" FontFamily="Consolas" FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Brand.Light}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brand.DarkBlue}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Čas pošiljanja" Binding="{Binding TimeText}" Width="105"/>
                <DataGridTextColumn Header="Poslano (request)" Binding="{Binding Request}" Width="*"/>
                <DataGridTextColumn Header="Čas prejema" Binding="{Binding ResponseTimeText}" Width="105">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResponse}" Value="False">
                                    <Setter Property="Foreground" Value="OrangeRed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Prejeto (response)" Binding="{Binding Response}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResponse}" Value="False">
                                    <Setter Property="Foreground" Value="OrangeRed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
