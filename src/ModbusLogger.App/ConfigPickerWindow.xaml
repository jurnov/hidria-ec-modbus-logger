<Window x:Class="ModbusLogger.App.ConfigPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModbusLogger.App"
        Title="{Binding DialogTitle}" Height="420" Width="380" MinHeight="300" MinWidth="320"
        WindowStartupLocation="CenterOwner" Icon="Assets/hidria.ico">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Foreground="{StaticResource Brand.DarkBlue}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Visibility="{Binding IsSaveMode, Converter={x:Static local:BoolToVisibleConverter.Instance}}">
            <TextBlock Text="Ime profila" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Shranjeni profili" Style="{StaticResource FieldLabel}"/>

        <ListBox Grid.Row="3" ItemsSource="{Binding AvailableConfigs}" SelectedItem="{Binding SelectedConfig}"/>

        <TextBlock Grid.Row="4" Text="{Binding ValidationMessage}" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="{Binding ValidationMessage, Converter={x:Static local:EmptyToCollapsedConverter.Instance}}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Prekliči" Command="{Binding CancelCommand}" Style="{StaticResource Brand.SecondaryButton}"
                    Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{Binding ConfirmButtonText}" Command="{Binding ConfirmCommand}" Style="{StaticResource Brand.PrimaryButton}"
                    Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
