<Window x:Class="ModbusLogger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModbusLogger.App"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="Hidria EC — Modbus RTU zapisovalnik" Height="680" Width="1000" MinHeight="480" MinWidth="800"
        Icon="Assets/hidria.ico">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Glava z znamko -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="0,0,0,8" BorderThickness="0,0,0,3"
                BorderBrush="{StaticResource Brand.HeaderAccent}">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/hidria_logo.png" Height="34" Margin="0,0,12,0"
                       HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock DockPanel.Dock="Left" Text="Modbus RTU zapisovalnik" VerticalAlignment="Center"
                           Foreground="{StaticResource Brand.DarkBlue}" FontSize="16" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <!-- Orodna vrstica -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                    Width="110" Height="34" Style="{StaticResource Brand.PrimaryButton}"/>
            <Button DockPanel.Dock="Left" Content="Naloži konfiguracijo" Command="{Binding ReloadCommand}"
                    Margin="8,0,0,0" Padding="10,6" Style="{StaticResource Brand.SecondaryButton}"/>
            <Button DockPanel.Dock="Left" Content="Shrani konfiguracijo" Command="{Binding SaveConfigCommand}"
                    Margin="8,0,0,0" Padding="10,6" Style="{StaticResource Brand.SecondaryButton}"/>
            <Button DockPanel.Dock="Left" Content="Odpri mapo logov" Command="{Binding OpenLogsCommand}"
                    Margin="8,0,0,0" Padding="10,6" Style="{StaticResource Brand.SecondaryButton}"/>
            <Button DockPanel.Dock="Left" Content="Modbus promet (HEX)" Command="{Binding ShowTrafficCommand}"
                    Margin="8,0,0,0" Padding="10,6" Style="{StaticResource Brand.SecondaryButton}"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                        ToolTip="Sprememba velja takoj, tudi med tekom beleženja.">
                <TextBlock Text="Interval vzorčenja [s]:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding IntervalSeconds}" Width="55" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ConfigPath}" VerticalAlignment="Center"
                       Foreground="#777" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
        </DockPanel>

        <!-- Glavni del: nastavitve | naprave | registri -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nastavitve porta -->
            <GroupBox Grid.Column="0" Padding="8" IsEnabled="{Binding IsStopped}">
                <GroupBox.Header>
                    <TextBlock Text="Povezava" Style="{StaticResource Brand.GroupHeader}"/>
                </GroupBox.Header>
                <StackPanel>
                    <TextBlock Text="COM port" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="⟳" Command="{Binding RefreshPortsCommand}" Width="26"
                                Padding="0" Margin="4,0,0,0" Style="{StaticResource Brand.SecondaryButton}"
                                ToolTip="Osveži seznam portov"/>
                        <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"/>
                    </DockPanel>

                    <TextBlock Text="Hitrost (baud)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding Baud}"/>

                    <TextBlock Text="Format (podatkovni/pariteta/stop)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding FramingOptions}" SelectedItem="{Binding Framing}"/>

                    <TextBlock Text="Timeout [ms]" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding TimeoutMs}"/>

                    <TextBlock Text="Ponovitve" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Retries}"/>

                    <CheckBox Content="Beleži v CSV" IsChecked="{Binding LogToCsv}" Margin="0,12,0,0"/>

                    <TextBlock Text="Za trajno shrani nastavitve z gumbom 'Shrani konfiguracijo' zgoraj."
                               TextWrapping="Wrap" Foreground="#999" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Seznam naprav -->
            <GroupBox Grid.Column="1" Padding="4" Margin="8,0,0,0">
                <GroupBox.Header>
                    <TextBlock Text="Naprave" Style="{StaticResource Brand.GroupHeader}"/>
                </GroupBox.Header>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Dodaj" Command="{Binding AddDeviceCommand}"
                                Style="{StaticResource Brand.SecondaryButton}" Padding="10,4"/>
                        <Button Content="Uredi" Command="{Binding EditDeviceCommand}"
                                Style="{StaticResource Brand.SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                        <Button Content="Odstrani" Command="{Binding RemoveDeviceCommand}"
                                Style="{StaticResource Brand.SecondaryButton}" Padding="10,4" Margin="6,0,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="12" Height="12" Fill="{Binding StatusBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold">
                                        <Run Text="{Binding Label, Mode=OneWay}"/>
                                        <Run Text="{Binding SlaveId, Mode=OneWay, StringFormat=' (slave {0})'}" Foreground="#777" FontWeight="Normal"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Status}" Foreground="#555" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding LastReadText}" Foreground="#999"
                                           FontSize="11" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Registri izbrane naprave: tabela ali graf -->
            <GroupBox Grid.Column="2" Padding="4" Margin="8,0,0,0">
                <GroupBox.Header>
                    <TextBlock Text="{Binding SelectedDevice.Label, FallbackValue=Registri}" Style="{StaticResource Brand.GroupHeader}"/>
                </GroupBox.Header>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{Binding ChartToggleText}" Command="{Binding ToggleChartViewCommand}"
                                Style="{StaticResource Brand.SecondaryButton}" Padding="10,4"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding IsChartView, Converter={x:Static local:BoolToVisibleConverter.Instance}}">
                            <ToggleButton x:Name="ParamsToggle" Content="Parametri ▾" Padding="10,4" Margin="0,0,8,0"/>
                            <TextBlock Text="Okno:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding TimeRangeOptions}" SelectedItem="{Binding SelectedTimeRange}" Width="70"/>
                        </StackPanel>
                    </DockPanel>

                    <Popup IsOpen="{Binding IsChecked, ElementName=ParamsToggle}" StaysOpen="False"
                           PlacementTarget="{Binding ElementName=ParamsToggle}" Placement="Bottom">
                        <Border Background="White" BorderBrush="{StaticResource Brand.Blue}" BorderThickness="1" Padding="6"
                                MaxHeight="320" MinWidth="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedDevice.Registers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <CheckBox IsChecked="{Binding ShowOnChart}" Content="{Binding DisplayName}" Width="180"/>
                                                <CheckBox IsChecked="{Binding UseRightAxis}" Content="desna os"
                                                          IsEnabled="{Binding ShowOnChart}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <DataGrid ItemsSource="{Binding SelectedDevice.Registers}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              CanUserSortColumns="False" CanUserReorderColumns="False"
                              Visibility="{Binding IsChartView, Converter={x:Static local:InverseBoolToVisibleConverter.Instance}}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource Brand.Light}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brand.DarkBlue}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Naslov" Binding="{Binding Address}" Width="80"/>
                            <DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Vrednost" Binding="{Binding ValueText}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Enota" Binding="{Binding Unit}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <oxy:PlotView Model="{Binding ChartModel}"
                                  Visibility="{Binding IsChartView, Converter={x:Static local:BoolToVisibleConverter.Instance}}"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <TextBlock Grid.Row="3" Text="Dnevnik dogodkov" Margin="0,8,0,2" Foreground="{StaticResource Brand.DarkBlue}" FontWeight="Bold"/>

        <!-- Dnevnik -->
        <ListBox Grid.Row="4" x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11"
                  BorderBrush="{StaticResource Brand.Blue}" BorderThickness="1"/>

        <!-- Statusna vrstica -->
        <StatusBar Grid.Row="5" Margin="0,6,0,0" Background="{StaticResource Brand.Light}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brand.DarkBlue}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
