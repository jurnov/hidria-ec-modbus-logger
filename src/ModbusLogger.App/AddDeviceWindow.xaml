<Window x:Class="ModbusLogger.App.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModbusLogger.App"
        xmlns:core="clr-namespace:ModbusLogger.Core;assembly=ModbusLogger.Core"
        Title="{Binding DialogTitle}" Height="580" Width="700" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner" Icon="Assets/hidria.ico">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,6,0,2"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" Foreground="{StaticResource Brand.DarkBlue}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Osnovni podatki -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="{x:Static core:Strings.AddDevice_Label_ImeNaprave}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static core:Strings.AddDevice_Label_SlaveId}" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SlaveId}"/>
            </StackPanel>
        </Grid>

        <!-- Profil -->
        <GroupBox Grid.Row="2">
            <GroupBox.Header>
                <TextBlock Text="{x:Static core:Strings.AddDevice_Group_Profil}" Style="{StaticResource Brand.GroupHeader}"/>
            </GroupBox.Header>
            <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#999" FontSize="11" Margin="0,0,0,8"
                           Text="{x:Static core:Strings.AddDevice_Hint_Profil}"/>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Left" Content="{x:Static core:Strings.AddDevice_Btn_NalPro}" Command="{Binding LoadProfileCommand}"
                            Style="{StaticResource Brand.SecondaryButton}" Padding="8,3" Margin="0,0,6,0"/>
                    <Button DockPanel.Dock="Left" Content="{x:Static core:Strings.AddDevice_Btn_IzbrisiPro}" Command="{Binding DeleteProfileCommand}"
                            Style="{StaticResource Brand.SecondaryButton}" Padding="8,3" Margin="0,0,16,0"/>
                    <Button DockPanel.Dock="Right" Content="{x:Static core:Strings.AddDevice_Btn_ShrKotPro}" Command="{Binding SaveAsProfileCommand}"
                            Style="{StaticResource Brand.SecondaryButton}" Padding="8,3"/>
                    <ComboBox ItemsSource="{Binding AvailableProfiles}" SelectedItem="{Binding ProfileToLoad}" Width="160"/>
                </DockPanel>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{x:Static core:Strings.AddDevice_Label_Registri}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button DockPanel.Dock="Right" Content="{x:Static core:Strings.AddDevice_Btn_OdstraniIzbranega}" Command="{Binding RemoveRegisterCommand}"
                            Style="{StaticResource Brand.SecondaryButton}" Padding="8,3" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="{x:Static core:Strings.AddDevice_Btn_PlusRegister}" Command="{Binding AddRegisterCommand}"
                            Style="{StaticResource Brand.SecondaryButton}" Padding="8,3"/>
                </DockPanel>

                <DataGrid x:Name="RegistersGrid" ItemsSource="{Binding Registers}" SelectedItem="{Binding SelectedRegister}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static core:Strings.AddDevice_Col_Naslov}" Width="75">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConstant}" Value="True">
                                            <Setter Property="Background" Value="#DDDDDD"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="ToolTip" Value="{x:Static core:Strings.AddDevice_Tooltip_KonstNaslov}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Address}" Padding="4,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsConstant, Converter={x:Static local:InverseBoolToVisibleConverter.Instance}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridComboBoxColumn Header="{x:Static core:Strings.AddDevice_Col_Funkcija}" SelectedItemBinding="{Binding Function}" Width="80"
                                                 ItemsSource="{x:Static local:RegisterOptions.Functions}"/>
                        <DataGridTextColumn Header="{x:Static core:Strings.AddDevice_Col_Ime}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="{x:Static core:Strings.AddDevice_Col_Enota}" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridComboBoxColumn Header="{x:Static core:Strings.AddDevice_Col_Tip}" SelectedItemBinding="{Binding Type}" Width="75"
                                                 ItemsSource="{x:Static local:RegisterOptions.Types}"/>
                        <DataGridTextColumn Header="{x:Static core:Strings.AddDevice_Col_Skala}" Binding="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridComboBoxColumn Header="{x:Static core:Strings.AddDevice_Col_WordOrder}" SelectedItemBinding="{Binding WordOrder}" Width="80"
                                                 ItemsSource="{x:Static local:RegisterOptions.WordOrders}"/>
                        <DataGridTextColumn Header="{x:Static core:Strings.AddDevice_Col_Konstanta}" Binding="{Binding ConstantValue, UpdateSourceTrigger=PropertyChanged}" Width="70">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip" Value="{x:Static core:Strings.AddDevice_Tooltip_KonstStolp}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConstant}" Value="False">
                                            <Setter Property="Background" Value="#DDDDDD"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding ValidationMessage}" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="{Binding ValidationMessage, Converter={x:Static local:EmptyToCollapsedConverter.Instance}}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static core:Strings.Btn_Preklici}" Command="{Binding CancelCommand}" Style="{StaticResource Brand.SecondaryButton}"
                    Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{x:Static core:Strings.Btn_Shrani}" Command="{Binding SaveCommand}" Style="{StaticResource Brand.PrimaryButton}"
                    Width="100" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
