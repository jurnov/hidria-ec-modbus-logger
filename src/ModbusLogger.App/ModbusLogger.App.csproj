<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ModbusLogger.Core\ModbusLogger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\hidria.ico" />
    <Resource Include="Assets\hidria_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\hidria.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <SatelliteResourceLanguages>sl;en;de;it;es</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
